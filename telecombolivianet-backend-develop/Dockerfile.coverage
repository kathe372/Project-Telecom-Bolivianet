# Variante del backend INSTRUMENTADA para medir cobertura de las pruebas E2E.
#
# Por qué hace falta una imagen aparte: las E2E entran por HTTP a un contenedor,
# así que `dotnet test --collect` no ve nada de lo que ejercitan. El resultado es
# que la capa Application aparece al 30,9 % cuando sus archivos con «cobertura
# cero» —CreateTicketCommand, RegisterClientCommand, CreateInstallationCommand—
# son justamente los que la suite recorre en cada ejecución. Sin esto, esa cifra
# es un suelo, no una medida.
#
# NO usar en producción: la imagen lleva el SDK y el proceso corre bajo un
# instrumentador, lo que la hace mucho más pesada y más lenta.

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY ["src/TelecomBoliviaNet.Presentation/TelecomBoliviaNet.Presentation.csproj",   "TelecomBoliviaNet.Presentation/"]
COPY ["src/TelecomBoliviaNet.Application/TelecomBoliviaNet.Application.csproj",     "TelecomBoliviaNet.Application/"]
COPY ["src/TelecomBoliviaNet.Infrastructure/TelecomBoliviaNet.Infrastructure.csproj","TelecomBoliviaNet.Infrastructure/"]
COPY ["src/TelecomBoliviaNet.Domain/TelecomBoliviaNet.Domain.csproj",               "TelecomBoliviaNet.Domain/"]

RUN dotnet restore "TelecomBoliviaNet.Presentation/TelecomBoliviaNet.Presentation.csproj"

COPY src/ .
WORKDIR "/src/TelecomBoliviaNet.Presentation"

# `DebugType=portable` explícito: coverlet necesita los .pdb junto a los .dll
# para poder mapear la ejecución a líneas de código fuente.
RUN dotnet publish "TelecomBoliviaNet.Presentation.csproj" \
      -c Release -o /app/publish \
      /p:UseAppHost=false /p:DebugType=portable /p:DebugSymbols=true

# El runtime se queda sobre el SDK, no sobre `aspnet`: coverlet.console es una
# herramienta de .NET y necesita el SDK para ejecutarse.
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS final
WORKDIR /app
EXPOSE 5000
ENV ASPNETCORE_URLS=http://+:5000
ENV PATH="${PATH}:/root/.dotnet/tools"

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

RUN dotnet tool install --global coverlet.console --version 6.*

COPY --from=build /app/publish .
RUN mkdir -p wwwroot/uploads/receipts wwwroot/uploads/qr /cobertura

# coverlet lanza el proceso y escribe el informe cuando termina ORDENADAMENTE.
# De ahí que el compose le dé un `stop_grace_period` amplio: con SIGKILL no hay
# informe, y el sintoma es un fichero que no aparece sin ningun error visible.
ENTRYPOINT ["coverlet", "/app", \
            "--target", "dotnet", \
            "--targetargs", "/app/TelecomBoliviaNet.Presentation.dll", \
            "--format", "cobertura", \
            "--output", "/cobertura/e2e.cobertura.xml", \
            "--include", "[TelecomBoliviaNet.*]*", \
            "--exclude", "[*]*.Migrations.*"]
