# ══════════════════════════════════════════════════════════════
# .env.test — Entorno de prueba local SIN WhatsApp
# Uso: cp .env.test .env && docker compose up
# ══════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3001

# ─── Base de datos ────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=chatbot_user
DB_PASSWORD=chatbot_secret
DB_DATABASE=chatbot_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_TTL=86400

# ─── Sistema C# (modo mock: el bot no falla si no responde) ───
SISTEMA_API_URL=http://host.docker.internal:5000
SISTEMA_BOT_EMAIL=bot@telecombolivianet.bo
SISTEMA_BOT_PASSWORD=test123
SISTEMA_JWT_REFRESH_MARGIN_MINUTES=60
SISTEMA_BOT_STATIC_TOKEN=test-token-local-dev

# ─── Meta (vacío en modo mock, no se usa) ─────────────────────
META_VERIFY_TOKEN=test_verify_token
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_API_VERSION=v18.0
META_API_URL=https://graph.facebook.com

# ─── Ollama ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_MAX_TOKENS=512
OLLAMA_TEMPERATURE=0.3

# ─── RAG ──────────────────────────────────────────────────────
RAG_SIMILARITY_THRESHOLD=0.75
# Ver nota en .env: es la ventana de historial de SessionService, no del RAG.
# Se mantiene igual que .env para que las pruebas reflejen producción.
RAG_CONTEXT_MESSAGES=20
# FASE D2 (2026-08-07): 3 -> 6. Medido en la base de produccion: 13 de 20 chunks
# mencionan "router" y solo 3 mencionan "comodato". Con 3 chunks, la pregunta
# "el router es mio o prestado" traia tres chunks de soporte tecnico (luz roja,
# reiniciar, velocidad) y el bot respondia "no tengo informacion" — teniendola
# literal en el chunk 0 de PLANES. Un termino frecuente ahogaba al especifico.
# Con 20 chunks en total, traer 6 no es caro.
RAG_MAX_CHUNKS=6

# ─── Storage ──────────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# MinIO (no requerido en pruebas locales)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chatbot-comprobantes

# ─── Bot ──────────────────────────────────────────────────────
BOT_MAX_RAG_ATTEMPTS=2
BOT_INSTALLATION_DAYS_AHEAD=7

# ─── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# ─── MODO MOCK ← ESTO ACTIVA LAS PRUEBAS SIN WHATSAPP ─────────
WHATSAPP_MOCK=true
