# ════════════════════════════════════════════════════════════════
# Telecom Bolivianet — Chatbot — Variables de entorno de ejemplo
#
# Copiar a .env y reemplazar los valores de ejemplo por los reales.
# NUNCA subir .env al repositorio — está excluido en .gitignore.
# ════════════════════════════════════════════════════════════════

# ─── Aplicación ─────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
APP_NAME=bolivianet-chatbot

# ─── Base de datos (PostgreSQL 16 + pgvector) ───────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=chatbot_user
DB_PASSWORD=change-me-in-prod
DB_DATABASE=chatbot_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ─── Redis 7 ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-in-prod
REDIS_DB=0

# TTL de sesión en dos niveles:
#   SESSION_CONVERSATION_TTL_MIN=30  — contexto activo de conversación (30 min)
#   REDIS_SESSION_TTL=86400          — retención de historial completo  (24 h)
# Decisión deliberada: el historial se guarda 24h para que el bot recuerde
# interacciones previas del mismo día; el contexto "activo" expira a los 30 min
# de inactividad para liberar memoria de trabajo.
REDIS_SESSION_TTL=86400
SESSION_CONVERSATION_TTL_MIN=30

# ─── Meta / WhatsApp Cloud API ──────────────────────────────────
META_VERIFY_TOKEN=placeholder-verify-token
META_APP_SECRET=placeholder-app-secret
META_ACCESS_TOKEN=placeholder-access-token
META_PHONE_NUMBER_ID=placeholder-phone-number-id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=placeholder-waba-id
META_API_VERSION=v18.0
META_API_URL=https://graph.facebook.com

# ─── Gemini (Google AI) ─────────────────────────────────────────
# Versión confirmada: gemini-2.0-flash (producción) / gemini-2.5-flash (opcional)
GEMINI_API_KEY=placeholder-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004
GEMINI_MAX_TOKENS=512
GEMINI_TEMPERATURE=0.3
# Para Vertex AI con Google Cloud billing (dejar vacío para AI Studio billing):
GOOGLE_SERVICE_ACCOUNT_JSON=
GEMINI_LOCATION=us-central1

# ─── Sistema central (ASP.NET Core 8 backend) ───────────────────
SISTEMA_API_URL=http://localhost:5000
SISTEMA_BOT_EMAIL=bot@telecombolivianet.bo
SISTEMA_BOT_PASSWORD=change-me-in-prod
SISTEMA_JWT_REFRESH_MARGIN_MINUTES=60
# Token estático mínimo 32 caracteres para endpoints internos /monitor/*
SISTEMA_BOT_STATIC_TOKEN=change-me-32-chars-min-required!!

# ─── RAG (Retrieval-Augmented Generation) ───────────────────────
# Umbral de similitud mínimo para aceptar un fragmento como contexto (§7 spec)
RAG_SIMILARITY_THRESHOLD=0.75
# Umbral de similitud para hit de caché semántica (más alto = más conservador)
RAG_CACHE_SIMILARITY=0.92
# Nombre heredado: NO es del RAG. Es la ventana de historial de la sesión
# (SessionService.MAX_MESSAGES) que se le manda a Gemini. Cuenta mensajes de
# ambos lados: 20 ≈ 10 turnos. No bajar de 20 sin medir — los flujos largos
# (instalación, 7 pasos) dejan de caber y el modelo pierde el contexto.
RAG_CONTEXT_MESSAGES=20
# FASE D2 (2026-08-07): 3 -> 6. Medido en la base de produccion: 13 de 20 chunks
# mencionan "router" y solo 3 mencionan "comodato". Con 3 chunks, la pregunta
# "el router es mio o prestado" traia tres chunks de soporte tecnico (luz roja,
# reiniciar, velocidad) y el bot respondia "no tengo informacion" — teniendola
# literal en el chunk 0 de PLANES. Un termino frecuente ahogaba al especifico.
# Con 20 chunks en total, traer 6 no es caro.
RAG_MAX_CHUNKS=6
RAG_FAIL_WINDOW_MINUTES=10
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_DEFAULT_H=24
RAG_CACHE_TTL_PRICING_H=6
RAG_CACHE_TTL_STATIC_H=168

# ─── Bot ────────────────────────────────────────────────────────
BOT_MAX_RAG_ATTEMPTS=2
BOT_INSTALLATION_DAYS_AHEAD=7
# Ventana de debounce para ráfagas de mensajes WhatsApp (ms, default: 2500)
DEBOUNCE_WINDOW_MS=2500

# ─── Rate limiting ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20

# ─── Almacenamiento de medios ───────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_URL=http://localhost:3001/uploads
# Supabase (si STORAGE_TYPE=supabase):
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=chatbot-uploads
# MinIO (si STORAGE_TYPE=minio):
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=chatbot-comprobantes

# ─── Modo mock (desarrollo sin WhatsApp real) ───────────────────
WHATSAPP_MOCK=false
