# ══════════════════════════════════════════════════════════════════════════
# TELECOM BOLIVIANET — Plantilla de variables de entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA comitas el archivo .env al repositorio.
# ══════════════════════════════════════════════════════════════════════════

# ── Base de datos PostgreSQL (backend) ────────────────────────────────────
# Generar con: openssl rand -base64 24
DB_PASSWORD=CAMBIAR_minimo_32_caracteres_aleatorios

# ── Base de datos PostgreSQL (chatbot + pgvector) ─────────────────────────
# Generar con: openssl rand -base64 24
CHATBOT_DB_PASSWORD=CAMBIAR_minimo_32_caracteres_aleatorios_diferente

# ── JWT — firma de tokens de acceso ────────────────────────────────────────
# HS256 requiere mínimo 128 bits (16 bytes). Usar mínimo 64 chars.
# Generar con: openssl rand -base64 48
JWT_KEY=CAMBIAR_generar_con_openssl_rand_base64_48

# ── Cifrado AES-256 de secrets en BD ───────────────────────────────────────
# DEBE ser diferente a JWT_KEY.
# Generar con: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=CAMBIAR_generar_con_openssl_rand_base64_32_DIFERENTE_A_JWT

# ── WhatsApp Meta Business API ──────────────────────────────────────────────
# developers.facebook.com → Tu App → WhatsApp → API Setup → Temporary access token
# Para token permanente ver: System Users en Business Settings
WHATSAPP_TOKEN=EAA_obtener_desde_meta_developers_portal

# developers.facebook.com → Tu App → Settings → Basic → App Secret → [Show]
META_APP_SECRET=obtener_desde_meta_developers_portal

# developers.facebook.com → Tu App → WhatsApp → API Setup → Phone number ID
WHATSAPP_PHONE_NUMBER_ID=solo_el_numero_sin_texto

# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost
FRONTEND_PORT=80

# ── Token de verificación del webhook de WhatsApp ───────────────────────────
# Token que inventas tú — debe coincidir con el ingresado en Meta Developer Console
# Generar con: openssl rand -hex 20
META_VERIFY_TOKEN=CAMBIAR_generar_con_openssl_rand_hex_20

# URL pública del chatbot (ngrok en desarrollo, dominio real en producción)
CHATBOT_PUBLIC_URL=https://TU_DOMINIO_O_NGROK_SIN_BARRA_FINAL

# false = WhatsApp real | true = modo consola sin Meta (desarrollo sin tokens)
WHATSAPP_MOCK=true

# ── Token estático para comunicación interna chatbot <-> backend ─────────────
# Generar con: openssl rand -hex 32
SISTEMA_BOT_STATIC_TOKEN=CAMBIAR_generar_con_openssl_rand_hex_32

# ── Credenciales del usuario bot ────────────────────────────────────────────
SISTEMA_BOT_EMAIL=bot@telecombolivianet.bo
# Generar con: openssl rand -base64 18
SISTEMA_BOT_PASSWORD=CAMBIAR_password_seguro_minimo_24_caracteres

# ── Contraseña inicial del admin (solo en BD vacía) ─────────────────────────
# Se aplica UNA sola vez, al crear el usuario admin semilla en una base nueva.
# Si se deja vacío se genera una aleatoria que se muestra en el log del arranque
# y obliga a cambiarla en el primer inicio de sesión.
# Generar con: openssl rand -base64 18
ADMIN_SEED_PASSWORD=CAMBIAR_password_inicial_seguro

# ── Contraseña de reset de emergencia para el admin ─────────────────────────
# Solo se aplica con RESET_ADMIN=true explícito. Si falta, el arranque continúa
# con una advertencia (antes lanzaba excepción e impedía arrancar el servicio).
# Cambiar inmediatamente después de cada uso
ADMIN_RESET_PASSWORD=CAMBIAR_password_temporal_seguro

# ── Swagger ─────────────────────────────────────────────────────────────────
# En producción queda deshabilitado salvo que se ponga true explícitamente
Swagger__Enabled=false

# ── Google Gemini AI ────────────────────────────────────────────────────────
# Obtener en: https://aistudio.google.com/app/apikey
# Sin esta key el chatbot usa solo regex para detectar intents (sin IA).
GEMINI_API_KEY=obtener_desde_google_ai_studio

# ── Google Service Account — OAuth2 para Gemini con billing en GCP ───────────
# Google Cloud Console → IAM → Cuentas de servicio → Tu SA → Claves → JSON
# Pegar TODO el JSON en una sola línea. Si hay $ en valores, reemplazar con $$.
# Si está vacío, se usa GEMINI_API_KEY (AI Studio billing).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Región de Vertex AI
GEMINI_LOCATION=us-central1

# ── Notifier worker ─────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=30
TIMEZONE=America/La_Paz
LOG_LEVEL=INFO

# ── Email ────────────────────────────────────────────────────────────────────
# Provider: Smtp (Gmail — envía a cualquier destinatario) o Resend (sandbox:
# solo envía al correo del dueño de la cuenta). Sin credenciales → modo STUB.
EMAIL_PROVIDER=Smtp
EMAIL_FROM_NAME=TelecomBoliviaNet

# Gmail SMTP — contraseña de aplicación: https://myaccount.google.com/apppasswords
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASSWORD=contrasena_de_aplicacion_16_caracteres

# Resend (alternativa, EMAIL_PROVIDER=Resend) — https://resend.com → API Keys
RESEND_API_KEY=re_obtener_desde_resend_dashboard
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# ── Supabase Storage ─────────────────────────────────────────────────────────
# Obtener en: supabase.com → tu proyecto → Settings → API
SUPABASE_URL=https://TU_PROYECTO_ID.supabase.co
SUPABASE_ANON_KEY=eyJ_obtener_desde_supabase_settings_api
SUPABASE_BACKEND_BUCKET=telecombolivianet-uploads
SUPABASE_CHATBOT_BUCKET=chatbot-uploads

# 'local' (usa disco) | 'supabase' (usa Supabase Storage)
STORAGE_TYPE=local

# ── Redis ────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 24
REDIS_PASSWORD=CAMBIAR_password_redis_minimo_32_caracteres
