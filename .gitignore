# ── Secretos y configuración local ──────────────────────────────────────────
.env
*.env
!.env.example

# Archivos de configuración de servicios individuales
telecombolivianet-backend-develop/.env
telecombolivianet-chatbot-develop/.env
telecombolivianet-notifier-develop/.env
telecombolivianet-frontend-develop/.env

# ── Configuración local de herramientas ──────────────────────────────────────
# settings.local.json llega a contener cadenas de conexión REALES de Railway
# (se guardan ahí como comandos permitidos). Nunca debe versionarse.
.claude/
scheduled_tasks.lock

# ── Dependencias ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Resultados de pruebas y artefactos de build ──────────────────────────────
test-results/
playwright-report/
**/bin/
**/obj/
**/dist/
**/TestResults/
*.trx
baseline.txt

# Salida de cobertura. Los patrones van ANCLADOS a su ruta exacta: un
# "coverage/" suelto es case-insensitive en Windows y se traga las carpetas de
# CÓDIGO llamadas Coverage/ (el módulo de cobertura de red vive en
# Domain/Entities/Coverage, Application/Coverage, etc.). Pasó: el primer push
# subió el repo sin el módulo entero y el CI lo detectó al no compilar en Linux.
/telecombolivianet-chatbot-develop/coverage/
/telecombolivianet-frontend-develop/frontend/coverage/

# ── Copias de seguridad locales ──────────────────────────────────────────────
*.BACKUP-*
Migrations.BACKUP*/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editores ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Docker volumes locales ───────────────────────────────────────────────────
uploads/
# Estado de las suites E2E: contienen tokens JWT y cookies de sesion reales.
# El patron cubre .estado-*.json y .api-estado.json — el segundo se escapaba del
# patron anterior y git ya lo tenia como no rastreado, listo para colarse en un
# `git add -A`.
e2e/.*.json
test-results/
playwright-report/
